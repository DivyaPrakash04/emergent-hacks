APP_URL=http://localhost:3000
PROVIDER_MODE=demo
DATABASE_PATH=.data/roomsure.sqlite
# Optional: set both values to use Turso instead of local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true in a hosted environment to fail closed if Turso is not configured.
TURSO_REQUIRED=false
# For provider-backed testing, set PROVIDER_MODE=stripe and all values below.
# Only sk_test_ keys are accepted. Live money movement is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Roomsure <onboarding@resend.dev>
